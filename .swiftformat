--swift-version 6.0
--language-mode 6
--min-version 0.62.1
--exclude .build,.tmp,DerivedData,Sci-Station.xcodeproj

# This deliberately small rule set is clean on the existing repository. It
# blocks new mechanical inconsistencies without reformatting legacy files.
--disable all
--enable duplicateImports,redundantBackticks,redundantExtensionACL,redundantFileprivate,redundantInternal,redundantLet,redundantPattern,redundantVoidReturnType,semicolons,spaceInsideBraces,spaceInsideComments,void
